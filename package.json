{
  "name": "create-uni-template",
  "displayName": "组件模板生成器",
  "description": "快速生成uni-app、Vue3和Vue2组件模板的VS Code扩展，支持Cursor编辑器",
  "version": "0.0.2",
  "publisher": "yy",
  "author": {
    "name": "yy"
  },
  "keywords": [
    "vue",
    "uni-app", 
    "template",
    "component",
    "generator",
    "cursor",
    "vscode"
  ],
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "create-uni-template.createComponent",
        "title": "🤗创建组件模板"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "create-uni-template.createComponent",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "create-uni-template.createComponent",
          "group": "navigation",
          "when": "explorerResourceIsFolder"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node copy-templates.js && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node copy-templates.js && node esbuild.js --production",
    "build": "pnpm run compile && pnpm run package",
    "package-vsce": "node copy-templates.js && vsce package",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.70.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.32.0",
    "esbuild": "^0.25.8",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
